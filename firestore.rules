rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() && (
        householdId == 'household-' + request.auth.uid ||
        (resource != null && (
          resource.data.ownerUid == request.auth.uid ||
          ('memberUids' in resource.data && request.auth.uid in resource.data.memberUids)
        )) ||
        (request.resource != null && (
          request.resource.data.ownerUid == request.auth.uid ||
          ('memberUids' in request.resource.data && request.auth.uid in request.resource.data.memberUids)
        ))
      );
    }

    // User Profile Documents (/users/{userId})
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && (
        !('pawPoints' in request.resource.data) || 
        request.resource.data.pawPoints == 0
      );
      allow update: if isOwner(userId) && (
        !('pawPoints' in request.resource.data) || 
        (resource != null && 'pawPoints' in resource.data && request.resource.data.pawPoints == resource.data.pawPoints) ||
        (resource != null && !('pawPoints' in resource.data) && request.resource.data.pawPoints == 0)
      );
      allow delete: if false;

      // Secure, read-only transaction history
      match /pawPointTransactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false; // written exclusively via server Admin SDK
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Household Data Collections (/households/{householdId})
    match /households/{householdId} {
      allow read, create, update, delete: if isHouseholdMember(householdId);

      match /{allSubcollections=**} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }

    // Deny unauthenticated or cross-account fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
