rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Reusable Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 4. Households (Pet Care Data)
    match /households/{householdId} {
      allow read, write: if isSignedIn() && isValidId(householdId);
    }

    // 5. Global Badges catalog
    match /badges/{badgeId} {
      allow read: if isSignedIn() && isValidId(badgeId);
      allow write: if false; // Read-only for app clients
    }

    // 6. User Badge Progress (Individual Achievements)
    match /users/{userId}/badgeProgress/{badgeId} {
      allow read: if isOwner(userId) && isValidId(badgeId);
      allow create: if isOwner(userId) && isValidId(badgeId) && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId) && isValidId(badgeId);
      allow update: if isOwner(userId) && isValidId(badgeId) && (
        // Showcase Action: user can pin/unpin to profile (affects only showcase field)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['showcase']) ||
        // General Update: must retain ownership constraints
        request.resource.data.userId == request.auth.uid
      );
    }

    // 7. Global Missions catalog
    match /missions/{missionId} {
      allow read: if isSignedIn() && isValidId(missionId);
      allow write: if false; // Read-only definitions
    }

    // 8. User Mission Progress
    match /users/{userId}/missionProgress/{missionId} {
      allow read: if isOwner(userId) && isValidId(missionId);
      allow create, delete: if isOwner(userId) && isValidId(missionId);
      allow update: if isOwner(userId) && isValidId(missionId) && request.resource.data.userId == request.auth.uid;
    }
  }
}
