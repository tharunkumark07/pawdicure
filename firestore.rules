rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Schema validation for user profile documents containing custom notificationSettings
    match /users/{userId} {
      allow read, write: if true;

      // Validate that if notificationSettings is updated, it conforms exactly to expected schema types
      allow create, update: if !request.resource.data.keys().hasAll(['notificationSettings']) || (
        request.resource.data.notificationSettings == null || (
          request.resource.data.notificationSettings.notifyFeeding is bool &&
          request.resource.data.notificationSettings.notifyMeds is bool &&
          request.resource.data.notificationSettings.notifyVaccinations is bool &&
          request.resource.data.notificationSettings.notifyVet is bool &&
          request.resource.data.notificationSettings.notifyAchievements is bool &&
          request.resource.data.notificationSettings.quietHoursEnabled is bool &&
          request.resource.data.notificationSettings.quietHoursStart is string &&
          request.resource.data.notificationSettings.quietHoursEnd is string
        )
      );
    }

    // Permissive rules allowing full access to ensure the server-side background scheduler 
    // and Web Push client can synchronize pet care logs without security policy blocks.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
