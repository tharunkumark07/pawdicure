{
  "entities": {
    "badge": {
      "title": "Badge Definition",
      "description": "A metadata definition for a rare and difficult digital badge in PAWdiCURE.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the badge"
        },
        "name": {
          "type": "string",
          "description": "The name of the badge"
        },
        "tier": {
          "type": "string",
          "enum": ["Bronze", "Silver", "Gold", "Mythic", "Transcendent"],
          "description": "The prestige level of the badge"
        },
        "icon": {
          "type": "string",
          "description": "Emoji or icon identifier representing the badge visually"
        },
        "description": {
          "type": "string",
          "description": "The description details for the badge"
        },
        "requirementText": {
          "type": "string",
          "description": "Brief explanation of the requirement"
        },
        "category": {
          "type": "string",
          "enum": ["CARE", "HEALTH", "NUTRITION", "ACTIVITY", "RELATIONSHIP", "MEMORIES", "EXPLORATION", "CONSISTENCY", "SAFETY", "RESPONSIBILITY", "COMMUNITY", "MASTERY", "LEGENDARY"],
          "description": "Care category the badge aligns with"
        },
        "difficulty": {
          "type": "string",
          "enum": ["Hard", "Extreme", "Insane", "Near Impossible"],
          "description": "Difficulty assessment"
        },
        "estimatedTime": {
          "type": "string",
          "description": "Estimated timeframe to earn"
        }
      },
      "required": ["id", "name", "tier", "icon", "description", "requirementText", "category", "difficulty", "estimatedTime"]
    },
    "badgeProgress": {
      "title": "User Badge Progress",
      "description": "User-specific tracking of progress and unlock status for a badge.",
      "type": "object",
      "properties": {
        "badgeId": {
          "type": "string",
          "description": "ID of the parent badge"
        },
        "userId": {
          "type": "string",
          "description": "ID of the user tracking progress"
        },
        "isUnlocked": {
          "type": "boolean",
          "description": "Whether the badge is unlocked"
        },
        "progressPercent": {
          "type": "integer",
          "description": "Percentage progress towards completion"
        },
        "progressLabel": {
          "type": "string",
          "description": "The label detailing exact progress e.g., '1,200 / 10,000 XP'"
        },
        "unlockedAt": {
          "type": "integer",
          "description": "Millisecond timestamp when unlocked, or null"
        },
        "showcase": {
          "type": "boolean",
          "description": "Whether this badge is pinned/showcased on the profile"
        }
      },
      "required": ["badgeId", "userId", "isUnlocked", "progressPercent", "progressLabel", "showcase"]
    },
    "mission": {
      "title": "Mission Definition",
      "description": "A long-term multi-task campaign structure.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique mission ID"
        },
        "title": {
          "type": "string",
          "description": "The headline of the mission"
        },
        "description": {
          "type": "string",
          "description": "The description of the campaign"
        },
        "category": {
          "type": "string",
          "enum": ["CARE", "HEALTH", "NUTRITION", "ACTIVITY", "RELATIONSHIP", "MEMORIES", "EXPLORATION", "CONSISTENCY", "SAFETY", "RESPONSIBILITY", "COMMUNITY", "MASTERY", "LEGENDARY"],
          "description": "Care category the mission aligns with"
        },
        "badgeRewardId": {
          "type": "string",
          "description": "The ID of the badge rewarded on completion"
        },
        "tasks": {
          "type": "array",
          "description": "Defined targets inside this mission"
        }
      },
      "required": ["id", "title", "description", "category", "badgeRewardId"]
    },
    "missionProgress": {
      "title": "User Mission Progress",
      "description": "User-specific state of active and completed tasks for a mission.",
      "type": "object",
      "properties": {
        "missionId": {
          "type": "string",
          "description": "The associated mission ID"
        },
        "userId": {
          "type": "string",
          "description": "The tracking user ID"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Completed"],
          "description": "Overall status of the mission"
        },
        "completedTasks": {
          "type": "array",
          "description": "Array of task IDs or names completed by the user"
        },
        "progressPercent": {
          "type": "integer",
          "description": "Overall completion percentage of the mission"
        },
        "completedAt": {
          "type": "integer",
          "description": "Millisecond timestamp of completion"
        }
      },
      "required": ["missionId", "userId", "status", "completedTasks", "progressPercent"]
    },
    "userProfile": {
      "title": "User Profile Settings",
      "description": "Stores user preferences, profile details, and system notification preferences.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "User's full name"
        },
        "email": {
          "type": "string",
          "description": "User's electronic mail address"
        },
        "avatar": {
          "type": "string",
          "description": "Avatar image source"
        },
        "theme": {
          "type": "string",
          "description": "Preferred UI theme (light, dark, or system)"
        },
        "notificationSettings": {
          "type": "object",
          "description": "Granular user level notification settings and Quiet Hours windows.",
          "properties": {
            "notifyFeeding": { "type": "boolean" },
            "notifyMeds": { "type": "boolean" },
            "notifyVaccinations": { "type": "boolean" },
            "notifyVet": { "type": "boolean" },
            "notifyAchievements": { "type": "boolean" },
            "quietHoursEnabled": { "type": "boolean" },
            "quietHoursStart": { "type": "string" },
            "quietHoursEnd": { "type": "string" }
          }
        }
      },
      "required": ["name", "email", "avatar", "theme", "notificationSettings"]
    },
    "careSettings": {
      "title": "Pet Care Settings & Safety Limits",
      "description": "Stores pet-specific safety limits and care guidance.",
      "type": "object",
      "properties": {
        "petId": { "type": "string" },
        "activityGuidance": { "type": "object" },
        "feedingGuidance": { "type": "object" },
        "treatGuidance": { "type": "object" },
        "medicationGuidance": { "type": "object" },
        "customRestrictions": { "type": "array", "items": { "type": "string" } },
        "veterinarianNotes": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["petId", "updatedAt"]
    },
    "vaccineRecord": {
      "title": "Clinical Vaccine Record",
      "description": "A verified clinical record for a pet's immunization.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "petId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["Core", "Non-Core", "Lifestyle"] },
        "status": { "type": "string", "enum": ["Administered", "Due", "Overdue", "Predicted", "Scheduled"] },
        "dueDate": { "type": "string" },
        "administeredDate": { "type": "string" },
        "vet": { "type": "string" },
        "manufacturer": { "type": "string" },
        "batchNumber": { "type": "string" },
        "verificationLevel": { "type": "string" },
        "isPrediction": { "type": "boolean" },
        "alert": { "type": "boolean" },
        "completed": { "type": "boolean" }
      }
    },
    "household": {
      "title": "Household Data Blob",
      "description": "The primary data structure for PAWdiCURE synchronization.",
      "type": "object",
      "properties": {
        "householdId": { "type": "string" },
        "syncCode": { "type": "string" },
        "activePetId": { "type": "string" },
        "vaccinationHistory": {
          "type": "array",
          "items": { "$ref": "#/entities/vaccineRecord" }
        }
      }
    },
    "routine": {
      "title": "Custom Pet Care Routine",
      "description": "Personalized daily/weekly routine orchestration document containing scheduled care activities.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "petId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "accent": { "type": "string" },
        "timezone": { "type": "string" },
        "active": { "type": "boolean" },
        "items": { "type": "array" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "userId", "petId", "name", "active", "items", "createdAt", "updatedAt"]
    },
    "routineExecution": {
      "title": "Routine Item Daily Execution Record",
      "description": "Daily status and completion log of a scheduled routine task for a specific date.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "routineId": { "type": "string" },
        "routineItemId": { "type": "string" },
        "petId": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["upcoming", "due", "completed", "missed", "skipped", "cancelled"] },
        "completedAt": { "type": "integer" },
        "linkedRecordId": { "type": "string" },
        "xpEarned": { "type": "integer" },
        "createdAt": { "type": "integer" }
      },
      "required": ["id", "routineId", "routineItemId", "petId", "userId", "date", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}/pets/{petId}/routines/{routineId}": {
      "schema": "routine",
      "description": "Stores personalized custom routines for a specific companion pet."
    },
    "/users/{userId}/pets/{petId}/routineExecutions/{executionId}": {
      "schema": "routineExecution",
      "description": "Tracks daily completion and skip logs for scheduled routine tasks."
    },
    "/households/{householdId}": {
      "schema": "household",
      "description": "Primary multi-device synchronization document for pet care data."
    },
    "/users/{userId}/pets/{petId}/careSettings/{settingId}": {
      "schema": "careSettings",
      "description": "Pet-specific safety guardrails and guidance."
    },
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Stores primary user account metadata and granular notification settings."
    },
    "/badges/{badgeId}": {
      "schema": "badge",
      "description": "Store defining the rare global badges available to unlock."
    },
    "/users/{userId}/badgeProgress/{badgeId}": {
      "schema": "badgeProgress",
      "description": "Stores current pet badge tracking metrics for a given user."
    },
    "/missions/{missionId}": {
      "schema": "mission",
      "description": "Defines long-term structural pet-care mission campaigns."
    },
    "/users/{userId}/missionProgress/{missionId}": {
      "schema": "missionProgress",
      "description": "Tracks sub-task completions of multi-step campaigns per user."
    }
  }
}
